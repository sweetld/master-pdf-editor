{
  "name": "master-pdf-editor-replica",
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --devtools",
    "smoke": "electron . --smoke --no-sandbox",
    "web": "python3 serve.py 8765",
    "vendor": "node scripts/vendor.mjs",
    "sample": "node samples/make-sample.mjs",
    "package": "node scripts/package.mjs all",
    "package:linux": "node scripts/package.mjs linux",
    "package:win": "node scripts/package.mjs win32",
    "package:mac": "node scripts/package.mjs darwin",
    "install:linux": "bash scripts/install-linux.sh",
    "uninstall:linux": "bash scripts/uninstall-linux.sh"
  },
  "keywords": [],
  "author": "Daud",
  "license": "AGPL-3.0-only",
  "description": "A from-scratch desktop re-implementation of the Master PDF Editor workspace (Electron, pdf.js, pdf-lib, MuPDF).",
  "dependencies": {
    "mupdf": "^1.28.1",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  },
  "private": true,
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "electron": "^41.7.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sweetld/master-pdf-editor.git"
  }
}